<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8E7">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#C0392B"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Title + Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"/>

            <Button android:id="@+id/btnMyProducts"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#FFFFFF"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/btn_my_items"
                android:textColor="#C0392B"
                android:textSize="9sp"/>

            <Button android:id="@+id/btnWishlist"
                android:layout_width="30dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#FFFFFF"
                android:text="❤️"
                android:textSize="12sp"
                android:padding="0dp"/>

            <Button android:id="@+id/btnAddProduct"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="#FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_add"
                android:textColor="#C0392B"
                android:textSize="11sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/app_subtitle"
            android:textColor="#FFCDD2"
            android:textSize="12sp"/>

        <!-- Search + Language Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <androidx.appcompat.widget.SearchView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/searchView"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/search_background"
                app:iconifiedByDefault="false"
                app:queryHint="@string/search_hint"
                app:searchIcon="@null"/>

            <!-- Language + Contact buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <Button android:id="@+id/btnLanguage"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:text="🌐"
                    android:textSize="16sp"
                    android:backgroundTint="#FFFFFF"
                    android:padding="0dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_language"
                    android:textSize="8sp"
                    android:textColor="#FFCDD2"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="6dp">

                <Button android:id="@+id/btnContactUs"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:text="📞"
                    android:textSize="16sp"
                    android:backgroundTint="#FFFFFF"
                    android:padding="0dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contact"
                    android:textSize="8sp"
                    android:textColor="#FFCDD2"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- PRICE RANGE FILTER — Step 13 -->
    <LinearLayout
        android:id="@+id/layoutPriceFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/price_range"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#795548"/>

            <TextView android:id="@+id/tvPriceRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0 - ₹10000"
                android:textSize="12sp"
                android:textColor="#C0392B"
                android:textStyle="bold"/>

        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10000"
            android:progress="10000"
            android:progressTint="#C0392B"
            android:thumbTint="#C0392B"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- CATEGORY TABS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button android:id="@+id/btnAll"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#F5A623"
                android:text="@string/category_all"
                android:textColor="#FFFFFF" android:textSize="11sp"/>

            <Button android:id="@+id/btnPainting"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_painting"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnDrawing"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_drawing"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnHandicraft"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_handicraft"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnTextile"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_textile"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnPottery"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_pottery"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnToys"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_toys"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnJewellery"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_jewellery"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnWoodcraft"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_woodcraft"
                android:textColor="#333333" android:textSize="11sp"/>

            <Button android:id="@+id/btnFood"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E0E0E0"
                android:text="@string/category_food"
                android:textColor="#333333" android:textSize="11sp"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- SORT + COUNT + PRICE FILTER ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView android:id="@+id/tvProductCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/all_products"
            android:textColor="#795548"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <!-- Price Filter Button -->
        <Button android:id="@+id/btnPriceFilter"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="💰"
            android:textSize="14sp"
            android:backgroundTint="#E0E0E0"
            android:layout_marginEnd="6dp"
            android:padding="0dp"/>

        <Button android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#E0E0E0"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_sort"
            android:textColor="#795548"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- SCROLL VIEW for sections -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- LOADING SKELETON — Step 20 -->
            <LinearLayout
                android:id="@+id/layoutSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <View android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="#E0E0E0"/>

                <View android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:background="#E0E0E0"/>

            </LinearLayout>

            <!-- FEATURED SECTION — Step 11 -->
            <LinearLayout
                android:id="@+id/layoutFeatured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/featured_products"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#795548"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerFeatured"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:clipToPadding="false"/>

            </LinearLayout>

            <!-- NEW ARRIVALS SECTION — Step 4 -->
            <LinearLayout
                android:id="@+id/layoutNewArrivals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingBottom="8dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_arrivals"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#795548"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerNewArrivals"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:clipToPadding="false"/>

            </LinearLayout>

            <!-- TRENDING SECTION — Step 16 -->
            <LinearLayout
                android:id="@+id/layoutTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingBottom="8dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trending_now"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#795548"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTrending"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:clipToPadding="false"/>

            </LinearLayout>

            <!-- ALL PRODUCTS SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_products_section"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#795548"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"/>

            <!-- EMPTY STATE -->
            <include
                android:id="@+id/emptyState"
                layout="@layout/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:visibility="gone"/>

            <!-- PRODUCT GRID -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:clipToPadding="false"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>