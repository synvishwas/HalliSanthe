<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProduct"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFF8E7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"/>

            <!-- SOLD Overlay -->
            <TextView
                android:id="@+id/tvSoldOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="SOLD"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="#BB000000"
                android:visibility="gone"/>

            <!-- ✅ Discount badge — Step 10 -->
            <TextView
                android:id="@+id/tvDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10% OFF"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/discount_background"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:visibility="gone"/>

            <!-- ✅ Wishlist button — Step 9 -->
            <TextView
                android:id="@+id/tvWishlist"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="🤍"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@drawable/wishlist_background"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Category"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/badge_background"/>

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Product Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvSellerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:text="by Artisan"
            android:textSize="11sp"
            android:textColor="#9E9E9E"/>

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:text="📍 Location"
            android:textSize="10sp"
            android:textColor="#795548"/>

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:text="₹ 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F5A623"/>

        <!-- ✅ View Count — Step 7 -->
        <TextView
            android:id="@+id/tvViewCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="👁️ 0 views"
            android:textSize="10sp"
            android:textColor="#9E9E9E"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>